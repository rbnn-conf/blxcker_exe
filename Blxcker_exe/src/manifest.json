{
  "_comment": "manifest.json: The core configuration file for the Chrome extension. It declares permissions, background scripts, and rulesets.",
  "manifest_version": 3,
  "name": "MiniShield",
  "version": "1.0",
  "description": "A minimal Chrome extension to block doubleclick.net",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blxcker_exe"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}